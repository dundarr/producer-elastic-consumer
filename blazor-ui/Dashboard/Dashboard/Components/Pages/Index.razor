@page "/"
@using System.Globalization
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject ProducerService Producer
@inject IConfiguration Config
@inject ILogger<Index> Logger
@implements IAsyncDisposable

<PageTitle>Queue Lab | KEDA</PageTitle>

<div class="dashboard">
    <header class="topbar">
        <div class="brand">
            <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
            <span>QUEUE<span class="brand-accent">/</span>LAB</span>
        </div>
        <span class="connection @(_online ? "online" : "")" role="status">
            <i></i>@(_online ? "En directo" : _pollError ? "Sin conexión" : "Conectando")
        </span>
    </header>

    <main>
        <section class="intro" aria-labelledby="page-title">
            <div>
                <p class="eyebrow"><span></span> KUBERNETES / KEDA</p>
                <h1 id="page-title">Autoescalado<br />por cola<span>.</span></h1>
            </div>
            <p class="intro-copy">Ajusta el ritmo de producción y observa cómo responden los consumidores a la carga.</p>
        </section>

        @if (_pollError)
        {
            <div class="notice" role="status">
                No se puede leer la telemetría. @(_snapshot is null ? "Reintentando…" : "Mostrando la última muestra recibida.")
            </div>
        }

        <div class="metrics" aria-label="Métricas actuales">
            <article class="metric queue">
                <h2><span></span> Mensajes en cola</h2>
                <p>@Display(_snapshot?.QueueLength)</p>
                <small>Recuento aproximado de Azure Queue</small>
            </article>
            <article class="metric consumers">
                <h2><span></span> Consumidores activos</h2>
                <p>@Display(_snapshot?.ConsumerCount)</p>
                <small>Hasta 2 mensajes/s por consumidor</small>
            </article>
            <article class="metric flow">
                <h2><span></span> Variación de la cola</h2>
                <p>@FlowLabel <small>msg/s</small></p>
                <small>@(Flow is > 0 ? "La cola crece" : Flow is < 0 ? "La cola se vacía" : Flow is 0 ? "Sin cambios entre muestras" : "Pendiente de dos muestras")</small>
            </article>
        </div>

        <div class="workspace">
            <section class="panel history" aria-labelledby="history-title">
                <header class="panel-heading">
                    <div>
                        <p class="eyebrow">TELEMETRÍA</p>
                        <h2 id="history-title">Historial de carga</h2>
                    </div>
                    <span class="tag">Últimos 2 min</span>
                </header>

                <TelemetryChart Samples="_history" />

                <div class="chart-footer">
                    <span><i class="key queue-key"></i> Cola</span>
                    <span><i class="key consumer-key"></i> Consumidores</span>
                    @if (_snapshot is { } latest)
                    {
                        <span class="sample-time">UTC @latest.SampledAt.UtcDateTime.ToString("HH:mm:ss")</span>
                    }
                </div>
            </section>

            <section class="panel controls" aria-labelledby="control-title">
                <header class="panel-heading">
                    <div>
                        <p class="eyebrow">CONTROL</p>
                        <h2 id="control-title">Productor</h2>
                    </div>
                    <span class="tag @(_snapshot?.IsRunning == true ? "running" : "")">
                        @(_snapshot is null ? "Sin datos" : _snapshot.IsRunning ? "Activo" : "Pausado")
                    </span>
                </header>

                <div class="rate-readout">
                    <span>Ritmo configurado</span>
                    <strong>@Display(_snapshot?.Rate) <small>msg/s</small></strong>
                </div>

                <form @onsubmit="UpdateRateAsync" @onsubmit:preventDefault>
                    <label for="rate">Nuevo ritmo <span>msg/s</span></label>
                    <div class="rate-form">
                        <input id="rate" type="number" min="1" step="1" required placeholder="@(_snapshot?.Rate.ToString() ?? "1")"
                               @bind="_rateInput" @bind:event="oninput" disabled="@ControlsDisabled" />
                        <button class="secondary" type="submit" disabled="@(ControlsDisabled || _rateInput is null or < 1)">Aplicar</button>
                    </div>
                </form>

                <button class="primary" type="button" @onclick="ToggleAsync" disabled="@ControlsDisabled">
                    <span aria-hidden="true">@(_snapshot?.IsRunning == true ? "Ⅱ" : "▶")</span>
                    @(_snapshot?.IsRunning == true ? "Pausar producción" : "Iniciar producción")
                </button>
                @if (_actionError is not null)
                {
                    <p class="action-error" role="alert">@_actionError</p>
                }
            </section>
        </div>
    </main>
</div>

@code {
    private static readonly CultureInfo DisplayCulture = CultureInfo.GetCultureInfo("es-ES");
    private readonly CancellationTokenSource _lifetime = new();
    private readonly SemaphoreSlim _requests = new(1);
    private readonly List<TelemetrySnapshot> _history = [];
    private TelemetrySnapshot? _snapshot;
    private Task? _polling;
    private int? _rateInput;
    private bool _online;
    private bool _pollError;
    private bool _busy;
    private string? _actionError;

    private bool ControlsDisabled => !_online || _busy;

    private double? Flow
    {
        get
        {
            if (_history.Count < 2 || !_online)
                return null;

            var current = _history[^1];
            var previous = _history[^2];
            var seconds = (current.SampledAt - previous.SampledAt).TotalSeconds;
            return seconds > 0 ? (current.QueueLength - previous.QueueLength) / seconds : null;
        }
    }

    private string FlowLabel => Flow?.ToString("+0.0;-0.0;0.0", DisplayCulture) ?? "—";
    private static string Display(int? value) => value?.ToString("N0", DisplayCulture) ?? "—";

    protected override void OnInitialized() => _polling = PollAsync(_lifetime.Token);

    private async Task PollAsync(CancellationToken ct)
    {
        var interval = Math.Clamp(Config.GetValue("ProducerApi:PollingIntervalSeconds", 2), 1, 30);
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(interval));
        try
        {
            do
            {
                await _requests.WaitAsync(ct);
                try
                {
                    await RefreshAsync(ct);
                }
                finally
                {
                    _requests.Release();
                }
                StateHasChanged();
            }
            while (await timer.WaitForNextTickAsync(ct));
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
        }
    }

    private async Task RefreshAsync(CancellationToken ct)
    {
        try
        {
            var snapshot = await Producer.GetSnapshotAsync(ct);
            _snapshot = snapshot;
            if (_history.Count > 0 && snapshot.SampledAt <= _history[^1].SampledAt)
                _history.Clear();

            _history.Add(snapshot);
            _history.RemoveAll(sample => sample.SampledAt < snapshot.SampledAt.AddMinutes(-2));
            _online = true;
            _pollError = false;
        }
        catch (Exception ex) when (!ct.IsCancellationRequested &&
            ex is HttpRequestException or OperationCanceledException or System.Text.Json.JsonException)
        {
            if (!_pollError)
                Logger.LogWarning(ex, "Could not refresh producer telemetry");
            _online = false;
            _pollError = true;
        }
    }

    private Task ToggleAsync() => _snapshot is { } snapshot
        ? ApplyAsync(ct => Producer.SetRunningAsync(!snapshot.IsRunning, ct))
        : Task.CompletedTask;

    private Task UpdateRateAsync() => _rateInput is > 0 and var rate
        ? ApplyAsync(ct => Producer.SetRateAsync(rate, ct))
        : Task.CompletedTask;

    private async Task ApplyAsync(Func<CancellationToken, Task> action)
    {
        if (ControlsDisabled)
            return;

        _busy = true;
        _actionError = null;
        var ct = _lifetime.Token;
        try
        {
            await _requests.WaitAsync(ct);
            try
            {
                await action(ct);
                await RefreshAsync(ct);
            }
            finally
            {
                _requests.Release();
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
        }
        catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException)
        {
            Logger.LogWarning(ex, "Could not change producer settings");
            _actionError = "No se pudo aplicar el cambio. Vuelve a intentarlo.";
        }
        finally
        {
            _busy = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        await _lifetime.CancelAsync();
        if (_polling is not null)
            await _polling;
        _lifetime.Dispose();
    }
}
